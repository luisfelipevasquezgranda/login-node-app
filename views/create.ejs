<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="stylesheet" href="/resources/css/style.css">
		<title>Nuevo usuario</title>
	</head>
	<body>
		<%- include('_nav', { active: 'security' }) %>
		<main class="dashboard-content">
			<section class="form-panel">
				<p class="eyebrow">Usuarios</p>
				<h1>Crear usuario</h1>
				<form action="/users" method="POST" class="user-form">
					<label>Nombre<input type="text" name="name" required maxlength="255"></label>
					<label>Contraseña<input type="password" name="password" required minlength="8"></label>
					<fieldset class="permissions-fieldset">
						<legend>Permisos de acceso</legend>
						<label class="permission-option"><input type="checkbox" name="CanAccessProducts" value="1"> Acceso a Productos</label>
						<label class="permission-option"><input type="checkbox" name="CanAccessSecurity" value="1"> Acceso a Seguridad</label>
					</fieldset>
					  <div class="button-row"><button type="submit">Guardar</button><a href="/seguridad" class="secondary-link">Cancelar</a></div>
				</form>
			</section>
		</main>
	</body>
</html>
