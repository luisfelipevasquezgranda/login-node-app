<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="resources/css/style.css">
    <title>Welcome</title>
  </head>
  <body class="text-center">
    <nav class="topbar">
      <a class="brand" href="/index"><img src="/resources/logo.svg" alt="Controla"><span>Controla</span></a>
      <ul class="nav-menu">
        <li><a href="/index">Principal</a></li>
        <li><a href="/tablas">Tablas</a></li>
        <li><a href="/facturacion">Facturas</a></li>
        <% if (canAccessSecurity) { %><li><a href="/seguridad">Seguridad</a></li><% } %>
        <li><a href="/ayuda">Ayuda</a></li>
        <li><a href="/acerca">Acerca de</a></li>
      </ul>
      <% if (login) { %>
        <a href="logout" class="a-logout">Logout</a>
      <% } else { %>
        <a href="login" class="a-login">Go to login</a>
      <% } %>
    </nav>

    <main class="dashboard-content">
      <section class="welcome-section">
        <p class="eyebrow">Panel principal</p>
        <h1>Bienvenido<% if (login) { %>, <%= name %><% } %></h1>
        <p>Selecciona un módulo para administrar la facturación o la seguridad del sistema.</p>
      </section>
    </main>

  </body>
</html>
